{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "custom:sleeping_z",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/sleeping_z"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 1.0,
        "max_particles": 4.0
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 4.0
      },
      "minecraft:emitter_shape_point": {
        "offset": [0.0, 0.0, 0.0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 4.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "math.clamp(variable.particle_age * 4.0, 0.0, 1.0) * (0.16 + (variable.particle_age / variable.particle_lifetime) * 0.24)",
          "math.clamp(variable.particle_age * 4.0, 0.0, 1.0) * (0.16 + (variable.particle_age / variable.particle_lifetime) * 0.24)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 64,
          "texture_height": 64,
          "uv": [0, 0],
          "uv_size": [64, 64]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "variable.particle_age / variable.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.25": "#FFFFFFFF",
            "0.75": "#FFFFFFFF",
            "1.0": "#00FFFFFF"
          }
        }
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.sin((variable.particle_age / variable.particle_lifetime) * 360.0) * 0.25 + (variable.particle_age / variable.particle_lifetime) * 0.35",
          "(variable.particle_age / variable.particle_lifetime) * 2.2",
          "0.0"
        ],
        "rotation": "math.sin((variable.particle_age / variable.particle_lifetime) * 360.0) * 12.0"
      }
    }
  }
}
